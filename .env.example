# Copy to .env and fill in. Never commit .env.

# ElevenLabs API key. Needs: Text to Speech, Voices (read + write), User (read).
ELEVENLABS_API_KEY=

# Google AI Studio key for Gemini.
GEMINI_API_KEY=

# The shared password for the login page.
APP_PASSWORD=

# Random string used to sign login cookies, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# Optional: maximum characters spoken per day (India time). Default 10000.
# DAILY_CHAR_LIMIT=10000
